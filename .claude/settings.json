{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(go build *)",
			"Bash(go test *)",
			"Bash(go vet *)",
			"Bash(go mod *)",
			"Bash(go run *)",
			"Bash(go tool *)",
			"Bash(golangci-lint *)",
			"Bash(bun install *)",
			"Bash(bun run *)",
			"Bash(bunx markdownlint-cli2 *)",
			"Bash(bunx playwright *)",
