# Copy to .env for local development (docker compose reads it too).
APP_NAME="Go Interview Quiz"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
# 32 random bytes, base64: `vukem key:generate` or `openssl rand -base64 32`.
# Optional with APP_ENV=development or test; production boot requires it.
APP_KEY=
HOST=localhost
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=

# Cookieless analytics, off when empty. ANALYTICS_PROVIDER: plausible | umami
ANALYTICS_PROVIDER=
# Script URL, e.g. https://plausible.io/js/script.js or https://cloud.umami.is/script.js
ANALYTICS_SCRIPT_URL=
# Plausible: the site domain (quiz.vukem.dev). Umami: the website ID (UUID).
ANALYTICS_SITE_ID=

# Requests per client IP per minute on quiz routes (/up is exempt). Default 120.
RATE_LIMIT_PER_MINUTE=
