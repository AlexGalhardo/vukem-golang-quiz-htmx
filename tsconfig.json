{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": false,
		"types": ["node"]
	},
	"include": ["resources/js/**/*.ts", "e2e/**/*.ts", "playwright.config.ts", "commitlint.config.ts"]
}
